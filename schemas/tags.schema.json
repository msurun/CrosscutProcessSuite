{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msurun/CrosscutProcessSuite/schemas/tags.schema.json",
  "title": "Tags Schema",
  "description": "Schema for defining tags in a process system.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      }
    }
  },
  "$defs": {
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "unit",
        "type",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "float",
            "bool",
            "enum"
          ]
        },
        "eng_min": {
          "type": "number"
        },
        "eng_max": {
          "type": "number"
        },
        "role": {
          "type": "string",
          "enum": [
            "PV",
            "SP",
            "OUT",
            "MODE",
            "DV",
            "CV",
            "MV",
            "other"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "driver",
            "address"
          ],
          "properties": {
            "driver": {
              "type": "string"
            },
            "address": {
              "type": "string"
            }
          }
        },
        "sample_period_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "writable": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
