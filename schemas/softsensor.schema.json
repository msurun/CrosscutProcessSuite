{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msurun/CrosscutProcessSuite/schemas/softsensor.schema.json",
  "title": "PLS soft sensor configuration",
  "description": "Data-only configuration of the advisory PLS soft sensor. mode can only be off or advisory: no write path exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "target_tag", "input_tags", "mode"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "description": {"type": "string"},
    "target_tag": {"type": "string", "minLength": 1},
    "input_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lags_s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "minimum": 0}, "default": [0, 300, 900, 1800]},
    "lab_delay_s": {"type": "number", "minimum": 0, "default": 3600},
    "sample_period_s": {"type": "number", "exclusiveMinimum": 0, "default": 60},
    "max_components": {"type": "integer", "minimum": 1, "default": 8},
    "cv_blocks": {"type": "integer", "minimum": 2, "default": 5},
    "mode": {"enum": ["off", "advisory"]}
  }
}
