{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msurun/CrosscutProcessSuite/schemas/auth-config.schema.json",
  "title": "Auth config",
  "description": "Optional site settings for sessions, lockout, passwords and the two-person rules, stored as <root>/_auth/config.json. A missing file means the defaults. Bounds keep the platform out of unsafe states; the kill, mode-down and reject permissions of every human role stay forced in code. Settings are changed by editing the file and restarting.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_idle_minutes": {"type": "integer", "minimum": 5, "maximum": 1440, "default": 60},
    "session_absolute_hours": {"type": "integer", "minimum": 1, "maximum": 72, "default": 12},
    "stepup_valid_minutes": {"type": "integer", "minimum": 1, "maximum": 30, "default": 5},
    "lockout_failures": {"type": "integer", "minimum": 3, "maximum": 20, "default": 5},
    "lockout_base_minutes": {"type": "integer", "minimum": 1, "maximum": 60, "default": 5},
    "lockout_max_minutes": {
      "type": "integer", "minimum": 1, "maximum": 1440, "default": 60,
      "description": "Must be at least lockout_base_minutes."
    },
    "login_rate_per_ip_per_min": {"type": "integer", "minimum": 5, "maximum": 600, "default": 20},
    "password_min_length": {"type": "integer", "minimum": 12, "maximum": 128, "default": 12},
    "require_second_admin_for_password_reset": {"type": "boolean", "default": true},
    "kill_file_enabled": {
      "type": "boolean", "default": true,
      "description": "Read by the gateway; the OS permissions on the _gateway folder are the control."
    },
    "allowed_origins": {
      "type": "array", "maxItems": 32, "uniqueItems": true, "default": [],
      "items": {"type": "string", "pattern": "^https?://[^/\\s]+$"}
    },
    "secure_cookie": {"enum": ["auto", "true", "false"], "default": "auto"}
  }
}
