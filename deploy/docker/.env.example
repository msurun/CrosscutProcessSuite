# Crosscut Docker deployment settings: template only, never a real secret.
# Copy this file outside the repository, for example to
# /etc/crosscut/crosscut.env, keep it mode 0600, and start the stack with
#   docker compose -f deploy/docker/docker-compose.yml \
#     --env-file /etc/crosscut/crosscut.env up -d --build
# Every variable below is read by docker-compose.yml or by the container entry
# points. Leave a value empty to use the default shown in the comment.

# Image tag built from deploy/docker/Dockerfile.
CROSSCUT_IMAGE=crosscut:local

# Path of this env file. Used by docker-compose.yml to load it into the api and
# runtime containers; the gateway receives its variables explicitly instead.
CROSSCUT_ENV_FILE=/etc/crosscut/crosscut.env

# Host TCP port of the console and JSON API. The container always listens on 8000.
CROSSCUT_API_PORT=8000

# Data root inside the containers, backed by the crosscut-data named volume.
CROSSCUT_ROOT=/var/lib/crosscut

# Folder of the gateway HMAC key (gateway-hmac.key, mode 0640). It lives in the
# crosscut-gateway volume so the gateway and the API share one signing key.
# Default: /var/lib/crosscut/_gateway/secrets
CROSSCUT_SECRETS_DIR=

# Folder of the JSON Schema contracts inside the image; do not change unless you
# build a custom image with a different layout.
CROSSCUT_SCHEMAS_DIR=/opt/crosscut/schemas

# Folder of the built console (index.html and assets) inside the image.
CROSSCUT_CONSOLE_DIR=/opt/crosscut/frontend/dist

# Uvicorn log level: critical, error, warning, info, debug or trace.
CROSSCUT_LOG_LEVEL=info

# Seconds between runtime service passes (default 1.0, must be positive).
CROSSCUT_RUNTIME_INTERVAL=1.0

# Live write policy path. It sits in the gateway volume because the gateway
# writes the policy pin next to it.
CROSSCUT_POLICY=/var/lib/crosscut/_gateway/policy/write-policy.json

# Plant map path. The gateway mounts the data root read-only and only reads it.
CROSSCUT_PLANT_MAP=/var/lib/crosscut/plant-map.json

# Gateway mode: off, advisory, dry_run, confirm or supervised. Start with
# advisory; raising it needs the two-person policy rules (ADR 013).
CROSSCUT_GATEWAY_MODE=advisory

# Gateway mailbox poll interval in seconds (default 1.0, must be positive).
CROSSCUT_GATEWAY_INTERVAL=1.0

# OPC UA connection timeout in seconds (default 2.0, must be positive).
CROSSCUT_GATEWAY_TIMEOUT=2.0

# KILL file handling: config reads _auth/config.json (default), on forces the
# file trigger, off ignores it. See docs/ADMIN_GUIDE.md section 6.
CROSSCUT_GATEWAY_KILL_FILE=config

# Optional bearer token for the PI Web API connector. Leave empty in this file;
# put the real value in an env file outside the repository or a Docker secret.
PI_READ_TOKEN=
