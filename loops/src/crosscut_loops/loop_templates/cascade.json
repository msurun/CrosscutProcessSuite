{
  "key": "cascade",
  "label": "Cascade inner or outer",
  "description": "A loop that is part of a cascade. Tune the inner loop first, then the outer loop on the identified closed inner loop; the template holds the tuning order.",
  "process_kind": "self_regulating",
  "dynamics": {
    "gain_min": 0.2,
    "gain_max": 5.0,
    "time_constant_s_min": 10.0,
    "time_constant_s_max": 600.0,
    "dead_time_s_min": 2.0,
    "dead_time_s_max": 60.0
  },
  "kpi_thresholds": {
    "service_factor_min": 0.9,
    "saturation_share_max": 0.05,
    "oscillation_index_max": 0.3,
    "noise_ratio_max": 0.2
  },
  "diagnosis_rules": ["instrument", "valve", "external", "design_or_mode", "tuning"],
  "tuning": {
    "rule": "simc",
    "target_closed_loop_time_constant_ratio": 1.5,
    "robustness": 0.4
  },
  "tests": {
    "allowed": ["step", "bump"],
    "default_step_pct": 3.0
  }
}
