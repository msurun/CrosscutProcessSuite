{
  "key": "composition",
  "label": "Composition or analyser",
  "description": "Composition control fed by a slow analyser or a virtual sensor. Respect the sample time and the analyser delay; tune slow and robust.",
  "process_kind": "self_regulating",
  "dynamics": {
    "gain_min": 0.05,
    "gain_max": 2.0,
    "time_constant_s_min": 300.0,
    "time_constant_s_max": 7200.0,
    "dead_time_s_min": 60.0,
    "dead_time_s_max": 600.0
  },
  "kpi_thresholds": {
    "service_factor_min": 0.85,
    "saturation_share_max": 0.05,
    "oscillation_index_max": 0.35,
    "noise_ratio_max": 0.3
  },
  "diagnosis_rules": ["instrument", "valve", "external", "design_or_mode", "tuning"],
  "tuning": {
    "rule": "simc",
    "target_closed_loop_time_constant_ratio": 3.0,
    "robustness": 0.7
  },
  "tests": {
    "allowed": ["step", "bump"],
    "default_step_pct": 3.0
  }
}
